# --- dependencies (regenerated by `npm install`) ---
node_modules/

# --- build output (regenerated by tsc / vite) ---
dist/
apps/web/dist/
packages/*/dist/

# --- raw source datasets: large and potentially licensed/sensitive ---
# The processed binary data/gb.f64 is committed so the app runs; regenerate it
# from these spreadsheets with `python scripts/extract_gb.py GB`.
*.xlsx
*.xls
*.parquet

# --- web-served data copy (regenerated by apps/web/scripts/copy-data.mjs) ---
apps/web/public/data/

# --- compressed payload (regenerated alongside data/gb.f64 by the extractor) ---
data/gb.f64.z

# --- secrets / local env (never commit) ---
.env
.env.*
*.pem
*.key
*.p12
*.pfx
secrets.json
**/credentials*.json

# --- editor / OS cruft ---
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# --- TS incremental build cache ---
*.tsbuildinfo
